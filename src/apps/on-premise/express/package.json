{
    "name": "@app/app-manager-express",
    "version": "1.0.1",
    "description": "App On Premise to manage AppManager requests",
    "keywords": [],
    "author": "Optiva Media an EPAM Company",
    "license": "MIT",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "./dist/"
    ],
    "typesVersions": {
        "*": {
            "dist/index.d.ts": [
                "dist/index.d.ts"
            ],
            "*": [
                "dist/*"
            ]
        }
    },
    "exports": {
        ".": "./dist/index.js",
        "./*": "./dist/*.js"
    },
    "scripts": {
        "precommit": "npx lint-staged",
        "lint": "npx eslint . --ext .js,.ts",
        "test": "yarn test:unit",
        "test:unit": "NODE_ENV=test jest --verbose --passWithNoTests",
        "build": "yarn build:clean && yarn build:tsc",
        "build:clean": "rm -r dist; exit 0",
        "build:tsc": "tsc && tscpaths -p tsconfig.json -s ./src -o ./dist",
        "serve": "nodemon src/index.ts"
    },
    "dependencies": {
        "@commitlint/cli": "^16.2.3",
        "@commitlint/config-conventional": "^16.2.1",
        "@context/deploymentConfigs": "^1.0.1",
        "@context/documents": "^1.0.1",
        "@context/environments": "^1.0.1",
        "@context/roles": "^1.0.1",
        "@context/shared": "^1.0.1",
        "express": "^4.19.2",
        "lodash": "^4.17.21",
        "moment": "^2.29.1"
    },
    "devDependencies": {
        "@cspell/dict-es-es": "3.0.0",
        "@types/aws-lambda": "^8.10.138",
        "@types/express": "^4.17.21",
        "@types/faker": "^5.5.9",
        "@types/jest": "^27.4.1",
        "@types/jest-when": "^3.5.0",
        "@types/lodash": "^4.17.4",
        "@types/mongoose": "^5.11.97",
        "@types/node": "^17.0.21",
        "@types/uuid": "^8.3.4",
        "@types/uuid-validate": "^0.0.1",
        "@typescript-eslint/eslint-plugin": "^7.11.0",
        "@typescript-eslint/parser": "^7.11.0",
        "concurrently": "^8.2.2",
        "cspell": "7.0.0",
        "dotenv": "^16.4.5",
        "eslint": "^8.10.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-import": "^2.25.4",
        "eslint-plugin-jest": "^26.1.1",
        "eslint-plugin-module-resolver": "^1.4.0",
        "jest": "^27.5.1",
        "jest-when": "^3.5.1",
        "lint-staged": "^12.3.4",
        "lodash": "^4.17.21",
        "nodemon": "^3.1.4",
        "ts-jest": "^27.1.4",
        "tscpaths": "^0.0.9",
        "typescript": "^5.4.5",
        "typescript-eslint": "^0.0.1-alpha.0"
    }
}
