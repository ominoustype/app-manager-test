{
    "name": "@context/documents",
    "version": "1.0.1",
    "description": "Documents context for app manager",
    "keywords": [],
    "author": "Optiva Media an EPAM Company",
    "license": "MIT",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "./dist/"
    ],
    "typesVersions": {
        "*": {
            "dist/index.d.ts": [
                "dist/index.d.ts"
            ],
            "*": [
                "dist/*"
            ]
        }
    },
    "exports": {
        ".": "./dist/index.js",
        "./*": "./dist/*.js"
    },
    "scripts": {
        "precommit": "npx lint-staged",
        "lint": "npx eslint . --ext .js,.ts",
        "test": "yarn test:unit",
        "test:unit": "NODE_ENV=test jest --verbose --passWithNoTests",
        "test:integration": "NODE_ENV=test NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --config=jest.config.integration.js --verbose --passWithNoTests",
        "build": "yarn build:clean && yarn build:tsc",
        "build:clean": "rm -r dist; exit 0",
        "build:tsc": "tsc && tscpaths -p tsconfig.json -s ./src -o ./dist",
        "build:prod": "yarn build:clean && yarn build:tsc:prod",
        "build:tsc:prod": "tsc -p tsconfig.dist.json && tscpaths -p tsconfig.dist.json -s ./src -o ./dist"
    },
    "dependencies": {
        "@commitlint/cli": "^16.2.3",
        "@commitlint/config-conventional": "^16.2.1",
        "@context/shared": "^1.0.1",
        "@context/environments": "^1.0.1",
        "aws-sdk": "^2.1082.0",
        "aws-xray-sdk": "^3.3.4",
        "dynamodb-onetable": "^2.3.6",
        "faker": "^5.5.3",
        "fast-glob": "^3.2.11",
        "lodash": "^4.17.21",
        "moment": "^2.29.1",
        "mongoose": "^8.5.1",
        "uuid": "^8.3.2",
        "uuid-validate": "^0.0.3"
    },
    "devDependencies": {
        "@cspell/dict-es-es": "3.0.0",
        "@types/jest": "^27.4.1",
        "@types/jest-when": "^3.5.0",
        "@types/lodash": "^4.17.4",
        "@typescript-eslint/eslint-plugin": "^7.11.0",
        "@typescript-eslint/parser": "^7.11.0",
        "cspell": "7.0.0",
        "eslint": "^8.10.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-import": "^2.25.4",
        "eslint-plugin-jest": "^26.1.1",
        "eslint-plugin-module-resolver": "^1.4.0",
        "jest": "^27.5.1",
        "jest-when": "^3.5.1",
        "lint-staged": "^12.3.4",
        "lodash": "^4.17.21",
        "ts-jest": "^27.1.4",
        "tscpaths": "^0.0.9",
        "typescript": "^5.4.5",
        "typescript-eslint": "^0.0.1-alpha.0"
    }
}
