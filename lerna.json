{
  "packages": [
    "src/contexts/*",
    "src/apps/*/*"
  ],
  "version": "independent",
  "npmClient": "yarn",
  "useWorkspaces": true,
  "command": {
    "version": {
      "message": "chore(release): publish %s",
      "allowBranch": [
        "main",
        "master"
      ]
    }
  },
  "lerna-dockerize": {
    "templateDockerfileName": "Dockerfile.template",
    "baseDockerfileName": "Dockerfile.base"
  }
}